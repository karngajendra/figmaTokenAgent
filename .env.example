# Figma Personal Access Token
# Generate at: https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=[TOKEN]

# The key from your Figma file URL:
# https://www.figma.com/file/<FILE_KEY>/...
FIGMA_FILE_KEY=[FILE_KEY]

# Optional: Specific mode to use for token values (e.g. "Light", "Dark")
# If not set, the default mode for each collection is used
FIGMA_MODE=Light
